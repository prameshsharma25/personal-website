# Copy to .env.local for local testing. Never put secret values in NEXT_PUBLIC variables.
# Checkout stays unavailable until every required server setting below is configured.
ESSAY_SALES_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
COMMERCE_ORIGIN=https://prameshsharma.com

# Upload private-products/Pramesh_Sharma_PhD_Essays.zip to a PRIVATE Vercel Blob store.
# Use the exact returned private URL, not a public URL or a public/ file path.
ESSAY_BUNDLE_BLOB_URL=
BLOB_READ_WRITE_TOKEN=
# Vercel OIDC authentication is also supported when a connected private store supplies
# BLOB_STORE_ID and VERCEL_OIDC_TOKEN. Do not copy short-lived OIDC tokens manually.

# Existing site Gmail transport, also used for buyer download emails.
USER_EMAIL=
GMAIL_APP_PASSWORD=
RECIPIENT_EMAIL=

# Optional future AdSense placement. Enabling requires a real display ad-unit ID.
# Public identifiers, not secrets. Rebuild after changing NEXT_PUBLIC values.
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_ARTICLE_SLOT=

# Custom newsletter: a private Google Sheet + Apps Script sending from your Gmail.
# See docs/GMAIL_NEWSLETTER_SETUP.md. All values here stay server-side.
NEWSLETTER_ENABLED=false
NEWSLETTER_GOOGLE_SCRIPT_URL=
NEWSLETTER_SHARED_SECRET=
NEWSLETTER_ADMIN_KEY=
NEWSLETTER_ORIGIN=https://prameshsharma.com
