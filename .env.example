# Copy to .env.local for local testing. Never put secret values in NEXT_PUBLIC variables.
# The optional direct Stripe checkout stays unavailable until all required settings are configured.
ESSAY_SALES_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
COMMERCE_ORIGIN=https://prameshsharma.com

# Upload private-products/Pramesh_Sharma_PhD_Essays.zip to a PRIVATE Vercel Blob store.
# Use the exact returned private URL, not a public URL or a public/ file path.
ESSAY_BUNDLE_BLOB_URL=
BLOB_READ_WRITE_TOKEN=
# Vercel OIDC authentication is also supported when a connected private store supplies
# BLOB_STORE_ID and VERCEL_OIDC_TOKEN. Do not copy short-lived OIDC tokens manually.

# Existing site Gmail transport, also used for buyer download emails.
USER_EMAIL=
GMAIL_APP_PASSWORD=
RECIPIENT_EMAIL=

# Optional future AdSense placement. Enabling requires a real display ad-unit ID.
# Public identifiers, not secrets. Rebuild after changing NEXT_PUBLIC values.
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_ARTICLE_SLOT=

# Published Gumroad products work without these optional overrides or Stripe credentials.
# Set GUMROAD_SALES_ENABLED=false to pause all Gumroad buttons; an empty URL pauses one.
# Redeploy after changing these values, including the statically generated UC guide.
GUMROAD_SALES_ENABLED=true
UC_ANNOTATIONS_GUMROAD_URL=https://pramesh6.gumroad.com/l/uc-essay-annotations
PHD_ESSAYS_GUMROAD_URL=https://pramesh6.gumroad.com/l/phd-application-essays

# Optional Python analysis worker for /tools/amyloid-inspector. Public URL, not a secret.
# Run services/amyloid locally or on a Docker host with persistent storage.
# Empty keeps on-device calculations, structure previews, and report inspection available.
# Example for local development: http://127.0.0.1:8001
AMYLOID_API_URL=
